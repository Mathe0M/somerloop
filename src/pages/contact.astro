---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config';
---
<Base
  title="Contact : parlons de votre projet"
  description="Décrivez en quelques lignes ce qui vous freine. Réponse sous 48 heures ouvrées, sans engagement. Agen, Toulouse et toute la France."
>
  <PageHero
    eyebrow="Contact"
    title="Parlons de <span class='hl'>votre projet</span>"
    lead="Quelques lignes suffisent. Je vous réponds sous 48 heures ouvrées avec une première piste ou quelques questions. Sans engagement."
    crumbs={[{ href: '/contact/', label: 'Contact' }]}
  />
  <section class="section">
    <div class="wrap split">
      <form class="card form" action="/contact.php" method="post" novalidate>
        <div class="row">
          <div class="field">
            <label for="nom">Nom et prénom <span aria-hidden="true">*</span></label>
            <input id="nom" name="nom" type="text" autocomplete="name" required maxlength="120" />
          </div>
          <div class="field">
            <label for="entreprise">Entreprise <span aria-hidden="true">*</span></label>
            <input id="entreprise" name="entreprise" type="text" autocomplete="organization" required maxlength="120" />
          </div>
        </div>
        <div class="row">
          <div class="field">
            <label for="email">E-mail professionnel <span aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" required maxlength="160" />
          </div>
          <div class="field">
            <label for="telephone">Téléphone <span class="opt">(facultatif)</span></label>
            <input id="telephone" name="telephone" type="tel" autocomplete="tel" maxlength="30" />
          </div>
        </div>
        <div class="field">
          <label for="sujet">Votre besoin</label>
          <select id="sujet" name="sujet">
            <option value="">Je ne sais pas encore</option>
            <option value="immersion-diagnostic">Immersion et diagnostic</option>
            <option value="logiciel-metier-sur-mesure">Logiciel métier sur mesure</option>
            <option value="automatisation-connexion-outils">Automatisation et connexion des outils</option>
            <option value="seo-technique-visibilite-locale">SEO technique et visibilité locale</option>
            <option value="suivi-evolution">Suivi et évolution</option>
          </select>
        </div>
        <div class="field">
          <label for="message">Qu'est-ce qui vous freine aujourd'hui ? <span aria-hidden="true">*</span></label>
          <textarea id="message" name="message" rows="6" required maxlength="5000" aria-describedby="message-aide"></textarea>
          <p class="help" id="message-aide">Par exemple : « Nous ressaisissons chaque commande dans trois logiciels » ou « Nous ne savons jamais où en est notre stock ».</p>
        </div>
        <!-- Champ piège anti-robots : invisible pour les humains -->
        <div class="hp" aria-hidden="true">
          <label for="site_web">Ne pas remplir</label>
          <input id="site_web" name="site_web" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="t" id="t" value="" />
        <p class="help">Les champs marqués d'un astérisque (*) sont obligatoires. Vos données servent uniquement à répondre à votre demande. <a href="/confidentialite/">En savoir plus</a>.</p>
        <p class="error" id="form-error" role="alert" hidden></p>
        <button class="btn btn--primary" type="submit">Envoyer ma demande <Icon name="arrow" size={18} /></button>
      </form>

      <aside class="side">
        <div class="card">
          <h2 class="h3">Vous préférez l'e-mail ?</h2>
          <p><a class="mail" href={`mailto:${SITE.email}`}><Icon name="mail" size={20} /> {SITE.email}</a></p>
          {SITE.phone && <p>{SITE.phone}</p>}
        </div>
        <div class="card">
          <h2 class="h3">Et ensuite ?</h2>
          <ol class="next">
            <li>Je lis votre message et je vous réponds sous 48 h ouvrées.</li>
            <li>On échange 30 minutes, en visio ou sur place à Agen et Toulouse.</li>
            <li>Je vous propose une première étape, avec un prix clair.</li>
          </ol>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('.form');
  const t = document.getElementById('t') as HTMLInputElement | null;
  if (t) t.value = String(Math.floor(Date.now() / 1000));

  const params = new URLSearchParams(location.search);
  const sujet = params.get('sujet');
  const select = document.getElementById('sujet') as HTMLSelectElement | null;
  if (sujet && select && [...select.options].some((o) => o.value === sujet)) select.value = sujet;

  const err = document.getElementById('form-error');
  if (params.get('erreur') && err) {
    err.hidden = false;
    err.textContent = "L'envoi n'a pas abouti. Vérifiez les champs ou écrivez-moi directement par e-mail.";
  }

  form?.addEventListener('submit', (e) => {
    const invalid = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')].filter((f) => !f.checkValidity());
    form.querySelectorAll('[aria-invalid]').forEach((f) => f.removeAttribute('aria-invalid'));
    if (invalid.length) {
      e.preventDefault();
      invalid.forEach((f) => f.setAttribute('aria-invalid', 'true'));
      if (err) {
        err.hidden = false;
        err.textContent = `Merci de compléter ou corriger : ${invalid.map((f) => form.querySelector(`label[for="${f.id}"]`)?.firstChild?.textContent?.trim()).join(', ')}.`;
      }
      invalid[0].focus();
    }
  });
</script>

<style>
  .split { display: grid; grid-template-columns: 1.6fr 1fr; gap: 2rem; align-items: start; }
  .form { display: grid; gap: 1.2rem; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .field { display: grid; gap: .4rem; }
  label { font-weight: 600; font-size: .97rem; }
  .opt { font-weight: 400; color: var(--ink-soft); }
  input, select, textarea {
    font: inherit; color: var(--ink); background: var(--bg); border: 1.5px solid #c9c4b8;
    border-radius: 10px; padding: .75rem .9rem; width: 100%;
  }
  input:focus, select:focus, textarea:focus { border-color: var(--loop); outline: 3px solid var(--loop-soft); outline-offset: 0; }
  [aria-invalid='true'] { border-color: #b42318; }
  .help { font-size: .9rem; color: var(--ink-soft); margin: 0; }
  .error { color: #b42318; font-weight: 600; margin: 0; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .form .btn { justify-self: start; }
  .side { display: grid; gap: 1.25rem; }
  .h3 { font-size: 1.2rem; }
  .mail { display: inline-flex; align-items: center; gap: .5rem; font-weight: 600; word-break: break-all; }
  .next { padding-left: 1.2rem; margin: 0; }
  .next li { margin-bottom: .5rem; }
  @media (max-width: 900px) { .split, .row { grid-template-columns: 1fr; } }
</style>
