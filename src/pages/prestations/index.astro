---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PrestationCards from '../../components/PrestationCards.astro';
import Cta from '../../components/Cta.astro';
---
<Base
  title="Prestations : logiciel sur mesure, automatisation, SEO et maintenance"
  description="Cinq prestations pour les PME en croissance : diagnostic, logiciel métier sur mesure, automatisation des outils, SEO technique et suivi, en projets découpés par étapes."
>
  <PageHero
    eyebrow="Prestations"
    title="Cinq façons de remettre vos outils <span class='hl'>au service</span> de votre croissance"
    lead="Les projets sont découpés en étapes et vous pouvez commencer petit. Si vous ne savez pas par où commencer, le diagnostic est fait pour ça."
    crumbs={[{ href: '/prestations/', label: 'Prestations' }]}
  />
  <section class="section">
    <div class="wrap">
      <PrestationCards />
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap grid grid-3">
      <div>
        <h2 class="h3">Commencer petit</h2>
        <p>Le diagnostic permet de démarrer avec un budget limité et de décider de la suite sur des bases concrètes.</p>
      </div>
      <div>
        <h2 class="h3">Pas d'effet tunnel</h2>
        <p>Les projets sont découpés en étapes courtes, chacune validée avant la suivante. Vous gardez la main sur le budget.</p>
      </div>
      <div>
        <h2 class="h3">Pas de promesse en l'air</h2>
        <p>Je ne garantis pas de résultat chiffré que je ne maîtrise pas. Je m'engage sur un travail propre, documenté et suivi.</p>
      </div>
    </div>
  </section>
  <Cta />
</Base>
<style> .h3 { font-size: 1.3rem; } </style>
