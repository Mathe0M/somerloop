---
import { getCollection } from 'astro:content';
import Legal from '../layouts/Legal.astro';
const prestations = (await getCollection('prestations')).sort((a, b) => a.data.order - b.data.order);
---
<Legal title="Plan du site" description="Toutes les pages du site somerloop.fr." path="/plan-du-site/" updated="novembre 2026">
  <ul>
    <li><a href="/">Accueil</a></li>
    <li><a href="/prestations/">Prestations</a>
      <ul>{prestations.map((p) => <li><a href={`/prestations/${p.id}/`}>{p.data.title}</a></li>)}</ul>
    </li>
    <li><a href="/realisations/">Réalisations</a></li>
    <li><a href="/parcours/">Parcours</a></li>
    <li><a href="/a-propos/">À propos et valeurs</a></li>
    <li><a href="/faq/">FAQ et aides publiques</a></li>
    <li><a href="/developpeur-logiciel-sur-mesure-agen/">Logiciel sur mesure à Agen</a></li>
    <li><a href="/contact/">Contact</a></li>
    <li><a href="/mentions-legales/">Mentions légales</a></li>
    <li><a href="/cgv/">Conditions générales de vente</a></li>
    <li><a href="/confidentialite/">Politique de confidentialité</a></li>
    <li><a href="/accessibilite/">Déclaration d'accessibilité</a></li>
  </ul>
</Legal>
