---
import Logo from './Logo.astro';
import { SITE } from '../config';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap cols">
    <div class="about">
      <Logo inverted />
      <p>Outils sur mesure, automatisation et visibilité pour les PME en croissance. Basé à Agen, à distance partout en France.</p>
      <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
    <nav aria-label="Prestations">
      <h2>Prestations</h2>
      <ul>
        <li><a href="/prestations/immersion-diagnostic/">Immersion et diagnostic</a></li>
        <li><a href="/prestations/logiciel-metier-sur-mesure/">Logiciel métier sur mesure</a></li>
        <li><a href="/prestations/automatisation-connexion-outils/">Automatisation des outils</a></li>
        <li><a href="/prestations/seo-technique-visibilite-locale/">SEO et visibilité locale</a></li>
        <li><a href="/prestations/suivi-evolution/">Suivi et évolution</a></li>
      </ul>
    </nav>
    <nav aria-label="Somerloop">
      <h2>Somerloop</h2>
      <ul>
        <li><a href="/realisations/">Réalisations</a></li>
        <li><a href="/parcours/">Parcours</a></li>
        <li><a href="/a-propos/">À propos et valeurs</a></li>
        <li><a href="/faq/">FAQ et aides publiques</a></li>
        <li><a href="/developpeur-logiciel-sur-mesure-agen/">Agen et Lot-et-Garonne</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap legal">
    <p>© {year} Somerloop</p>
    <ul>
      <li><a href="/mentions-legales/">Mentions légales</a></li>
      <li><a href="/cgv/">CGV</a></li>
      <li><a href="/confidentialite/">Confidentialité</a></li>
      <li><a href="/accessibilite/">Accessibilité : partiellement conforme</a></li>
      <li><a href="/plan-du-site/">Plan du site</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: #d0d5dd; padding-top: 4rem; font-size: .97rem; }
  .cols { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 2.5rem; padding-bottom: 3rem; }
  .about p { margin-top: 1rem; max-width: 36ch; }
  h2 { font-size: 1rem; color: #fff; margin-bottom: 1rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin-bottom: .5rem; }
  a { color: #d0d5dd; text-decoration: none; }
  a:hover { color: var(--accent); text-decoration: underline; }
  .legal {
    border-top: 1px solid rgb(255 255 255 / 0.12); padding-block: 1.4rem;
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; font-size: .88rem;
  }
  .legal p { margin: 0; }
  .legal ul { display: flex; flex-wrap: wrap; gap: 1.2rem; }
  .legal li { margin: 0; }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr; } }
</style>
