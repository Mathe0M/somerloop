---
import Breadcrumbs from './Breadcrumbs.astro';
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: { href: string; label: string }[];
}
const { eyebrow, title, lead, crumbs } = Astro.props;
---
<section class="hero">
  <div class="wrap">
    {crumbs && <Breadcrumbs items={crumbs} />}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 set:html={title} />
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2.5rem, 5vw, 4rem);
    background:
      radial-gradient(circle at 92% 10%, var(--loop-soft) 0, transparent 32%),
      radial-gradient(circle at 80% 90%, var(--accent-soft) 0, transparent 30%);
    border-bottom: 1px solid var(--line);
  }
  h1 { max-width: 20ch; }
</style>
