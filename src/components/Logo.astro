---
interface Props { inverted?: boolean; size?: number }
const { inverted = false, size = 34 } = Astro.props;
const ink = inverted ? '#ffffff' : '#101828';
---
<span class="logo" style={`--logo-ink:${ink}`}>
  <svg width={size} height={size} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <!-- Une boucle ouverte : le levier qui relance la machine -->
    <path d="M30.5 12.2A13 13 0 1 0 33 20" fill="none" stroke={ink} stroke-width="5" stroke-linecap="round" />
    <circle cx="20" cy="20" r="5.2" fill="#5b3fd6" />
    <circle cx="31.6" cy="12.6" r="4.4" fill="#ff6a3d" />
  </svg>
  <span class="logo__word">somerloop</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: .55rem; }
  .logo__word {
    font-family: var(--font-title); font-weight: 700; font-size: 1.45rem;
    letter-spacing: -0.035em; color: var(--logo-ink); line-height: 1;
  }
</style>
